{
  "name": "astraya",
  "version": "0.43.1",
  "private": true,
  "type": "module",
  "description": "Astrological calculation and charting webapp powered by the Swiss Ephemeris",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/run-without-warnings.mjs sh -c \"tsc -b && vite build && vite build --config vite.sw.config.ts\"",
    "build:demo": "tsc -b && vite build --mode demo && vite build --mode demo --config vite.sw.config.ts",
    "preview": "vite preview",
    "serve": "node server/index.ts",
    "test": "node scripts/run-without-warnings.mjs vitest run",
    "test:coverage": "vitest run --coverage",
    "knip": "knip --no-exit-code",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --noEmit",
    "ops:rotate-key": "node server/ops/rotate-key.ts",
    "ephe:sync": "node scripts/sync-ephemeris.mjs",
    "docker:smoke": "node scripts/docker-smoke.mjs",
    "corpus:split": "node scripts/split-corpus.mjs",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "changelog:draft": "node scripts/changelog-draft.mjs",
    "corpus:similarity": "node scripts/corpus-similarity-report.mjs",
    "corpus:review-report": "node scripts/corpus-review-report.mjs",
    "corpus:verify": "npx tsx --env-file=.env.local tools/corpus-gen/verify-batch.mjs",
    "corpus:stats": "node tools/corpus-gen/corpus-stats.mjs",
    "corpus:audit": "npx tsx tools/corpus-gen/audit-corpus.mjs",
    "corpus-gen": "tools/corpus-gen/run.sh",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@astrodraw/astrochart": "^3.0.2",
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@node-rs/argon2": "^2.2.1",
    "@photostructure/tz-lookup": "11.7.0",
    "fastify": "^5.12.3",
    "jose": "^6.2.12",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "luxon": "^3.7.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "svg2pdf.js": "^2.8.1",
    "sweph-wasm": "2.6.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@playwright/test": "^1.63.0",
    "@types/luxon": "^3.7.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.6",
    "fast-check": "^4.9.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "knip": "6.42.1",
    "prettier": "3.9.10",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "core-js@3.51.0": false
  }
}
