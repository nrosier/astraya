{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nrosier/astraya/docs/schema/astraya-export.schema.json",
  "title": "Astraya full export",
  "description": "Hand-authored structural counterpart to src/domain/full-export.ts's FullExport/ExportedPerson/ExportedChart TypeScript interfaces (#561). See ../domain/EXPORT_SCHEMA.md for the compatibility policy and version history. This document is maintained by hand, not generated — keep it in step with the TypeScript source when either changes.",
  "type": "object",
  "required": ["format", "version", "exportedAt", "app", "preferences", "note", "people"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "astraya-export" },
    "version": { "type": "integer", "minimum": 1 },
    "exportedAt": { "type": "string", "format": "date-time" },
    "app": {
      "type": "object",
      "required": ["version"],
      "additionalProperties": false,
      "properties": { "version": { "type": "string" } }
    },
    "preferences": {
      "type": "object",
      "required": ["settings", "rulership", "symbolClass"],
      "additionalProperties": false,
      "properties": {
        "settings": { "type": "object", "description": "ExtendedSettings — see src/chart/extended-settings.ts" },
        "rulership": {
          "enum": ["modern", "traditional", "both"],
          "description": "The device's default rulership (v4, #806); a person's own is exportedPerson.rulership"
        },
        "symbolClass": { "type": "string" }
      }
    },
    "note": { "type": "string" },
    "people": { "type": "array", "items": { "$ref": "#/$defs/exportedPerson" } },
    "research": { "$ref": "#/$defs/exportedResearch" }
  },
  "$defs": {
    "degreeParts": {
      "type": "object",
      "required": ["sign", "degree", "minute", "second"],
      "properties": {
        "sign": { "type": "string" },
        "degree": { "type": "integer" },
        "minute": { "type": "integer" },
        "second": { "type": "integer" }
      }
    },
    "exportedResearch": {
      "type": "object",
      "description": "Saved event-search queries, pins and their annotations (#1194, additive: the version stays 4). Live items only; absent when there are none",
      "required": ["savedQueries", "pins"],
      "additionalProperties": false,
      "properties": {
        "savedQueries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "definition"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^q-[a-z2-7]{16}$" },
              "name": { "type": "string" },
              "definition": {
                "type": "object",
                "description": "SavedQueryDefinition: tool, version and the Event search parameters, see src/store/saved-queries.ts"
              }
            }
          }
        },
        "pins": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "target"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^k-[a-z2-7]{16}$" },
              "target": {
                "type": "object",
                "description": "PinTarget: the pinned sky event (tool, version, kind, instant in whole seconds, bodies, aspect, label), see src/store/pins.ts"
              },
              "annotation": {
                "type": "object",
                "description": "The pin's annotation, every revision (head and forks)",
                "required": ["revisions"],
                "additionalProperties": false,
                "properties": { "revisions": { "type": "array", "items": { "$ref": "#/$defs/exportedNoteRevision" } } }
              }
            }
          }
        },
        "omittedUnreadable": {
          "type": "integer",
          "minimum": 1,
          "description": "Live items this build could not read exactly, left out of the file"
        }
      }
    },
    "exportedNoteRevision": {
      "type": "object",
      "description": "One immutable note revision (#919): text, the revision ids it was written on top of, and its HLC",
      "required": ["id", "text", "parents", "hlc"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "text": {
          "type": "string",
          "description": "At most 50,000 characters, except a legacy root (id prefixed legacy-) written before the limit existed"
        },
        "parents": { "type": "array", "items": { "type": "string" } },
        "hlc": { "type": "string", "description": "The hybrid logical clock timestamp the revision was written with" }
      }
    },
    "exportedPerson": {
      "type": "object",
      "required": ["id", "displayName", "placeLabel", "timeAccuracy", "notes", "missing"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "displayName": { "type": "string" },
        "placeLabel": { "type": "string" },
        "timeAccuracy": { "enum": ["recorded", "remembered", "approximate", "unknown"] },
        "notes": { "type": "string" },
        "birth": { "type": "object", "description": "BirthMomentInput — see src/time/types.ts" },
        "birthNote": {
          "type": "object",
          "description": "The Birth Record note's revisions (#919, additive); notes is the head's text",
          "required": ["revisions"],
          "additionalProperties": false,
          "properties": { "revisions": { "type": "array", "items": { "$ref": "#/$defs/exportedNoteRevision" } } }
        },
        "consultationNotes": {
          "type": "array",
          "description": "The person's Consultation notes, oldest first (#919, additive)",
          "items": {
            "type": "object",
            "required": ["id", "revisions"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "description": "The note id: the first revision's id" },
              "revisions": { "type": "array", "items": { "$ref": "#/$defs/exportedNoteRevision" } }
            }
          }
        },
        "missing": { "type": "array", "items": { "type": "string" } },
        "relocationPlaces": {
          "type": "array",
          "items": { "type": "object", "description": "RelocationPlace — see src/domain/person.ts" }
        },
        "calculationSettings": {
          "type": "object",
          "description": "ExtendedSettings (#806, v3) — this person's own chart settings, see src/chart/extended-settings.ts; absent in v2 files"
        },
        "rulership": {
          "enum": ["modern", "traditional", "both"],
          "description": "The planetary rulers this person's charts were computed with (#806, v4); absent in v2 and v3 files"
        },
        "customPoints": {
          "type": "array",
          "items": { "type": "object", "description": "CustomPointDefinition — see src/domain/person.ts" }
        },
        "natalChart": { "$ref": "#/$defs/exportedChart" },
        "harmonicCharts": { "type": "array", "items": { "$ref": "#/$defs/exportedHarmonicChart" } },
        "chartError": { "type": "string" },
        "calculation": {
          "type": "object",
          "description": "CalculationArtifact (#582) — see src/domain/calculation-artifact.ts",
          "required": ["moment", "snapshot", "provenance", "fingerprint"],
          "properties": {
            "moment": { "type": "object" },
            "snapshot": { "type": "object" },
            "provenance": { "type": "object" },
            "fingerprint": {
              "type": "object",
              "required": ["algorithm", "snapshotHash", "inputHash", "resultHash"],
              "properties": {
                "algorithm": { "const": "sha-256" },
                "snapshotHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "inputHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "resultHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              }
            }
          }
        }
      }
    },
    "exportedChart": {
      "type": "object",
      "required": [
        "sect",
        "positions",
        "aspects",
        "dignities",
        "dispositors",
        "antiscia",
        "declinations",
        "midpointTree",
        "allMidpoints"
      ],
      "additionalProperties": false,
      "properties": {
        "sect": { "enum": ["day", "night"] },
        "positions": { "type": "array", "items": { "type": "object" } },
        "houses": {
          "type": "object",
          "required": ["cusps", "angles", "derivedPoints"],
          "additionalProperties": false,
          "properties": {
            "cusps": { "type": "array", "items": { "type": "object" } },
            "angles": { "type": "array", "items": { "type": "object" } },
            "derivedPoints": { "type": "array", "items": { "type": "object" } }
          }
        },
        "aspects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "bodyAKey",
              "bodyAName",
              "bodyBKey",
              "bodyBName",
              "aspect",
              "aspectKey",
              "angle",
              "separation",
              "orb",
              "applying"
            ],
            "properties": {
              "bodyAKey": { "type": "string" },
              "bodyAName": { "type": "string" },
              "bodyBKey": { "type": "string" },
              "bodyBName": { "type": "string" },
              "aspect": { "type": "string" },
              "aspectKey": { "type": "string" },
              "angle": { "type": "number" },
              "separation": { "type": "number" },
              "orb": { "type": "number" },
              "applying": { "type": "boolean" }
            }
          }
        },
        "dignities": { "type": "array", "items": { "type": "object" } },
        "dispositors": { "type": "array", "items": { "type": "object" } },
        "antiscia": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["bodyKey", "bodyName", "contactKey", "contactName", "kind", "orb"],
            "properties": {
              "bodyKey": { "type": "string" },
              "bodyName": { "type": "string" },
              "contactKey": { "type": "string" },
              "contactName": { "type": "string" },
              "kind": { "enum": ["antiscion", "contraAntiscion"] },
              "orb": { "type": "number" }
            }
          }
        },
        "declinations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["bodyAKey", "bodyAName", "bodyBKey", "bodyBName", "kind", "orb"],
            "properties": {
              "bodyAKey": { "type": "string" },
              "bodyAName": { "type": "string" },
              "bodyBKey": { "type": "string" },
              "bodyBName": { "type": "string" },
              "kind": { "enum": ["parallel", "contraparallel"] },
              "orb": { "type": "number" }
            }
          }
        },
        "midpointTree": {
          "type": "array",
          "items": {
            "allOf": [
              { "$ref": "#/$defs/degreeParts" },
              {
                "type": "object",
                "required": [
                  "bodyKey",
                  "bodyName",
                  "pairAKey",
                  "pairAName",
                  "pairBKey",
                  "pairBName",
                  "midpoint",
                  "orb"
                ],
                "properties": {
                  "bodyKey": { "type": "string" },
                  "bodyName": { "type": "string" },
                  "pairAKey": { "type": "string" },
                  "pairAName": { "type": "string" },
                  "pairBKey": { "type": "string" },
                  "pairBName": { "type": "string" },
                  "midpoint": { "type": "number" },
                  "orb": { "type": "number" }
                }
              }
            ]
          }
        },
        "allMidpoints": {
          "type": "array",
          "items": {
            "allOf": [
              { "$ref": "#/$defs/degreeParts" },
              {
                "type": "object",
                "required": ["bodyAKey", "bodyAName", "bodyBKey", "bodyBName", "kind", "midpoint"],
                "properties": {
                  "bodyAKey": { "type": "string" },
                  "bodyAName": { "type": "string" },
                  "bodyBKey": { "type": "string" },
                  "bodyBName": { "type": "string" },
                  "kind": { "enum": ["direct", "indirect"] },
                  "midpoint": { "type": "number" }
                }
              }
            ]
          }
        }
      }
    },
    "exportedHarmonicChart": {
      "type": "object",
      "required": ["key", "label", "harmonic", "source", "radixPositions", "chart"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string" },
        "label": { "type": "string" },
        "harmonic": { "type": "integer", "minimum": 1 },
        "source": {
          "type": "object",
          "required": ["kind", "transform", "houses"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "radix" },
            "transform": { "const": "longitude-times-n-mod-360" },
            "houses": { "const": "whole-sign-from-harmonic-ascendant" }
          }
        },
        "radixPositions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["bodyKey", "bodyName", "radixLongitude", "harmonicLongitude"],
            "additionalProperties": false,
            "properties": {
              "bodyKey": { "type": "string" },
              "bodyName": { "type": "string" },
              "radixLongitude": { "type": "number" },
              "harmonicLongitude": { "type": "number" }
            }
          }
        },
        "chart": { "$ref": "#/$defs/exportedChart" }
      }
    }
  }
}
